rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================
    // DENY ALL by default
    // ========================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ========================================
    // Helper functions
    // ========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidString(field, maxLen) {
      return field is string && field.size() > 0 && field.size() <= maxLen;
    }


    function isPositiveInt(field) {
      return field is int && field >= 0;
    }

    function isStrictPositiveInt(field) {
      return field is int && field > 0;
    }

    function hasTimestamps(data) {
      return ('createdAt' in data) && ('updatedAt' in data);
    }

    function createdAtUnchanged() {
      return request.resource.data.createdAt == resource.data.createdAt;
    }

    // "Absent OU valide" : un champ optionnel ne doit jamais être obligatoire,
    // sous peine de rejeter les documents existants qui ne l'ont pas encore.
    // null est traité comme absent (Money?/int? nul se sérialise en `null`,
    // la clé reste présente dans le document).
    function optionalPositiveInt(data, field) {
      return !(field in data) || data[field] == null || isPositiveInt(data[field]);
    }

    function validDefaultRates(data) {
      return !('defaultRates' in data) || data.defaultRates == null || (
        data.defaultRates is map
        && optionalPositiveInt(data.defaultRates, 'hour')
        && optionalPositiveInt(data.defaultRates, 'halfDay')
        && optionalPositiveInt(data.defaultRates, 'day')
        && optionalPositiveInt(data.defaultRates, 'fixedJob')
      );
    }

    function optionalNonNegativeNumber(data, field) {
      return !(field in data) || data[field] == null
        || ((data[field] is int || data[field] is float) && data[field] >= 0);
    }

    function optionalString(data, field, maxLen) {
      return !(field in data) || data[field] == null
        || (data[field] is string && data[field].size() <= maxLen);
    }

    function optionalBool(data, field) {
      return !(field in data) || data[field] == null || data[field] is bool;
    }

    function optionalListMax(data, field, maxLen) {
      return !(field in data) || data[field] == null
        || (data[field] is list && data[field].size() <= maxLen);
    }

    function optionalMap(data, field) {
      return !(field in data) || data[field] == null || data[field] is map;
    }

    function optionalEnum(data, field, allowed) {
      return !(field in data) || data[field] == null || data[field] in allowed;
    }

    // ========================================
    // USERS - Allow authenticated users to create/manage their own profile
    // ========================================
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // ========================================
    // CLIENTS
    // ========================================
    match /users/{userId}/clients/{clientId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && isValidString(request.resource.data.name, 200)
        && request.resource.data.type in ['patron', 'client_particulier', 'entreprise']
        && validDefaultRates(request.resource.data)
        && hasTimestamps(request.resource.data);

      allow update: if isOwner(userId)
        && isValidString(request.resource.data.name, 200)
        && request.resource.data.type in ['patron', 'client_particulier', 'entreprise']
        && validDefaultRates(request.resource.data)
        && hasTimestamps(request.resource.data)
        && createdAtUnchanged();

      allow delete: if isOwner(userId);
    }

    // ========================================
    // PROJECTS (Chantiers)
    // ========================================
    match /users/{userId}/projects/{projectId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && isValidString(request.resource.data.clientId, 100)
        && isValidString(request.resource.data.label, 200)
        && request.resource.data.status in ['actif', 'termine', 'en_attente']
        && optionalEnum(request.resource.data, 'type', [
          'nouvelle_installation', 'mise_en_conformite', 'depannage',
          'renovation', 'domotique', 'autre'
        ])
        && hasTimestamps(request.resource.data);

      allow update: if isOwner(userId)
        && isValidString(request.resource.data.clientId, 100)
        && isValidString(request.resource.data.label, 200)
        && request.resource.data.status in ['actif', 'termine', 'en_attente']
        && optionalEnum(request.resource.data, 'type', [
          'nouvelle_installation', 'mise_en_conformite', 'depannage',
          'renovation', 'domotique', 'autre'
        ])
        && hasTimestamps(request.resource.data)
        && createdAtUnchanged();

      allow delete: if isOwner(userId);
    }

    // ========================================
    // WORK ENTRIES
    // ========================================
    match /users/{userId}/workEntries/{entryId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && isValidString(request.resource.data.date, 10)
        && request.resource.data.startTime is int
        && request.resource.data.startTime >= 0
        && request.resource.data.startTime <= 1439
        && request.resource.data.endTime is int
        && request.resource.data.endTime >= 0
        && request.resource.data.endTime <= 1439
        && isPositiveInt(request.resource.data.laborAmountHT)
        && request.resource.data.billingMode in ['hourly', 'half_day', 'day', 'fixed_job']
        && isValidString(request.resource.data.clientId, 100)
        && hasTimestamps(request.resource.data);

      allow update: if isOwner(userId)
        && isValidString(request.resource.data.date, 10)
        && request.resource.data.startTime is int
        && request.resource.data.startTime >= 0
        && request.resource.data.startTime <= 1439
        && request.resource.data.endTime is int
        && request.resource.data.endTime >= 0
        && request.resource.data.endTime <= 1439
        && isPositiveInt(request.resource.data.laborAmountHT)
        && request.resource.data.billingMode in ['hourly', 'half_day', 'day', 'fixed_job']
        && isValidString(request.resource.data.clientId, 100)
        && hasTimestamps(request.resource.data)
        && createdAtUnchanged();

      allow delete: if isOwner(userId);
    }

    // ========================================
    // EXPENSES
    // ========================================
    match /users/{userId}/expenses/{expenseId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && isValidString(request.resource.data.date, 10)
        && isValidString(request.resource.data.clientId, 100)
        && request.resource.data.category in ['materials', 'travel', 'food', 'other']
        && isPositiveInt(request.resource.data.amountHT)
        && isValidString(request.resource.data.description, 500)
        && optionalEnum(request.resource.data, 'materialCategory', [
          'cables', 'disjoncteurs', 'goulottes', 'outillage', 'luminaires',
          'prises_interrupteurs', 'tableau', 'autre'
        ])
        && optionalEnum(request.resource.data, 'travelMode', ['per_km', 'forfait', 'non_facture'])
        && hasTimestamps(request.resource.data);

      allow update: if isOwner(userId)
        && isValidString(request.resource.data.date, 10)
        && isValidString(request.resource.data.clientId, 100)
        && request.resource.data.category in ['materials', 'travel', 'food', 'other']
        && isPositiveInt(request.resource.data.amountHT)
        && isValidString(request.resource.data.description, 500)
        && optionalEnum(request.resource.data, 'materialCategory', [
          'cables', 'disjoncteurs', 'goulottes', 'outillage', 'luminaires',
          'prises_interrupteurs', 'tableau', 'autre'
        ])
        && optionalEnum(request.resource.data, 'travelMode', ['per_km', 'forfait', 'non_facture'])
        && hasTimestamps(request.resource.data)
        && createdAtUnchanged();

      allow delete: if isOwner(userId);
    }

    // ========================================
    // PAYMENTS
    // ========================================
    match /users/{userId}/payments/{paymentId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && isValidString(request.resource.data.date, 10)
        && isValidString(request.resource.data.clientId, 100)
        && isStrictPositiveInt(request.resource.data.amount)
        && request.resource.data.method in ['cash', 'virement', 'autre']
        && hasTimestamps(request.resource.data);

      allow update: if isOwner(userId)
        && isValidString(request.resource.data.date, 10)
        && isValidString(request.resource.data.clientId, 100)
        && isStrictPositiveInt(request.resource.data.amount)
        && request.resource.data.method in ['cash', 'virement', 'autre']
        && hasTimestamps(request.resource.data)
        && createdAtUnchanged();

      allow delete: if isOwner(userId);
    }

    // ========================================
    // SETTINGS
    // ========================================
    match /users/{userId}/settings/{settingId} {
      allow read: if isOwner(userId);

      // Validation de type sur les champs connus de Settings (lib/features/
      // settings/domain/entities/settings.dart), pattern "absent/null ou
      // valide" pour rester rétrocompatible avec les documents existants.
      // Plafond de clés + de taille de liste/chaîne en l'absence d'un
      // contrôle de taille de document natif en rules Firestore.
      allow write: if isOwner(userId)
        && optionalPositiveInt(request.resource.data, 'dayHours')
        && optionalPositiveInt(request.resource.data, 'halfDayHours')
        && optionalPositiveInt(request.resource.data, 'defaultPauseMinutes')
        && optionalPositiveInt(request.resource.data, 'roundingMinutes')
        && optionalNonNegativeNumber(request.resource.data, 'minBillingHours')
        && optionalPositiveInt(request.resource.data, 'minBillingAmountCents')
        && optionalString(request.resource.data, 'currency', 10)
        && optionalString(request.resource.data, 'country', 10)
        && optionalPositiveInt(request.resource.data, 'travelRatePerKmCents')
        && optionalListMax(request.resource.data, 'quickTasks', 200)
        && optionalListMax(request.resource.data, 'quickVendors', 200)
        && optionalMap(request.resource.data, 'pdfHeader')
        && optionalBool(request.resource.data, 'autoBackupEnabled')
        && optionalString(request.resource.data, 'lastBackupAt', 40)
        && optionalPositiveInt(request.resource.data, 'schemaVersion')
        && request.resource.data.keys().size() <= 20;
    }

    // ========================================
    // CLIENT SETTLEMENTS (Remises à zéro de compte)
    // ========================================
    match /users/{userId}/client_settlements/{settlementId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && isValidString(request.resource.data.clientId, 100)
        && isValidString(request.resource.data.date, 10)
        && request.resource.data.balanceAtSettlement is int
        && ('createdAt' in request.resource.data);

      // Les soldes sont immuables une fois créés : ni update, ni delete.
      // M2 (SECURITY_AUDIT.md) — delete était autorisé au propriétaire,
      // ce qui permettait de contourner l'immuabilité par delete+recreate.
      // deleteSettlement() existe côté repository mais n'est appelé par
      // aucune page/widget de lib/features/clients/presentation/pages/ :
      // verrouillage à coût fonctionnel nul aujourd'hui.
      allow update: if false;
      allow delete: if false;
    }
  }
}
